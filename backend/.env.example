DATABASE_URL=postgresql://username:password@localhost:5432/career_db

CAREER_UPSTREAM_BASE_URL=http://127.0.0.1:8000
CAREER_UPSTREAM_TIMEOUT_SECONDS=10

# Component 01 isolated prototype storage; replace with shared DB after review.
# SKILL_DATABASE_PATH=/absolute/path/to/skills.sqlite3
SKILL_ENABLE_SBERT=false

# Account authentication. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# SQLite requires a persistent volume on Railway; use a single backend replica.
# AUTH_DATABASE_PATH=/data/auth.sqlite3
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local HTTP only. Set true for HTTPS production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_FRONTEND_URL=http://localhost:5173
# Password reset delivery (SMTP with STARTTLS):
# AUTH_SMTP_HOST=smtp.example.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_FROM=CareerNova <accounts@example.com>
# AUTH_SMTP_USERNAME=
# AUTH_SMTP_PASSWORD=
# Profile page for Google sign-in accounts: the same public values as the frontend's
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY. Used only to confirm a Google user's access token.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# Cached model directory, used only when semantic matching is enabled.
# SKILL_SBERT_MODEL_PATH=/absolute/path/to/all-MiniLM-L6-v2

# Career Market Pulse (Home page). Snapshots are stored in DATABASE_URL when it holds real
# PostgreSQL credentials (the placeholder above is ignored), otherwise in .data/market.sqlite3.
# MARKET_DATABASE_URL=postgresql://user:password@host:5432/career_db   # optional override of DATABASE_URL
# MARKET_DATABASE_PATH=/absolute/path/to/market.sqlite3
# Hours between collections from the job boards (started when the Home page asks for stale data).
MARKET_REFRESH_HOURS=12
# Set false to stop the API from collecting by itself (tests, or when a scheduler runs
# `python -m app.market_pulse.refresh` instead).
MARKET_AUTO_REFRESH=true
# Job sources (Arbeitnow, Remote OK, Remotive, Himalayas, Jobicy) are free public APIs and need no keys.
