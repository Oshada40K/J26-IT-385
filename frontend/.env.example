# Copy to .env.local for local overrides. On Vercel, set this in
# Project Settings -> Environment Variables (it is baked in at build time).
# No trailing slash. Must be HTTPS when the frontend is served from Vercel.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public Supabase project settings; never use a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
